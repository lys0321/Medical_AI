# 复制本文件为 .env 并填写；.env 已在 .gitignore 中，不会提交到仓库。
# 填好之后直接启动服务即可，不用改动任何代码。

# 1) 内置模型 API（OpenAI 兼容接口）。留空则只用本机 Ollama。
#    智谱（免费档 glm-4-flash）：
MEDNEXUS_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MEDNEXUS_MODEL=glm-4-flash
MEDNEXUS_API_KEY=

# 2) 云端开关。设为 0/false/off 时强制只用本机 Ollama（完全不出网）。
MEDNEXUS_CLOUD=1

# 3) 教材答疑是否交给模型组织语言。默认关闭，用原文摘录式回答。
#    开启后仍会逐条回查引用，页码对不上就丢弃改用摘录。
MEDNEXUS_ASK_MODEL=0

# 4) 本机 Ollama（可选）。只允许本机地址，防止对话外发。
MEDNEXUS_TUTOR_URL=http://127.0.0.1:11434
MEDNEXUS_TUTOR_MODEL=

# 5) 文献检索（PubMed E-utilities）可选，填邮箱可提高配额。
MEDNEXUS_NCBI_EMAIL=